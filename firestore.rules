rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isEmailAdmin() {
      return request.auth != null && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'satyammasterofai@gmail.com' ||
          request.auth.token.email.lower() == 'jhahimanshukumar87@gmail.com' ||
          request.auth.token.email.lower() == 'sigmaphotography0001@gmail.com'
        );
    }

    function isRoleAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function isAdmin() {
      return isEmailAdmin() || isRoleAdmin();
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (resource != null && resource.data.get('role', '') == 'admin')
      );
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Designers Collection - public read for approved/directory/orders assignment, self or admin write
    match /designers/{designerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == designerId);
      allow delete: if isAdmin();
    }

    // Website Management Collections
    match /templates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ecards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /content/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /template_categories/{document=**} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /categories/{document=**} { 
      allow read, write: if true; 
    } 
    
    match /categories_bak/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /selfVideoTemplates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      // Users can read/update their own orders, assigned designers can read/update assigned orders, admins can read/update all
      allow read, update: if isAdmin() || (isAuthenticated() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) || 
        (resource != null && resource.data.get('assignedDesignerId', '') == request.auth.uid)
      ));
      allow delete: if isAdmin();
    }

    match /order_files/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isAuthenticated() && (
        (resource != null && resource.data.get('userId', '') == request.auth.uid) || 
        (resource != null && resource.data.get('assignedDesignerId', '') == request.auth.uid)
      ));
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /custom_forms/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /template_reviews/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
    }

    match /notifications/{document=**} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    match /service_enquiries/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /chats/{document=**} {
      allow create: if (isAuthenticated() && request.resource.data.get('userId', '') == request.auth.uid) || isAdmin();
      allow read, update, delete: if isAdmin() || (isAuthenticated() && resource.data.get('userId', '') == request.auth.uid);
    }
    
    match /chat_typing/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
